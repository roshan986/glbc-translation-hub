# Google Apps Script Web App Deployment URL
# Deploy Code.gs as Web App (Execute as: Me, Who has access: Anyone)
# Paste your deployed exec URL below:
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec

# Firebase Authentication Configuration (Web App)
# Get these from Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Super Admin Configuration
# Enter your designated Super Admin Gmail address (comma-separated if multiple):
VITE_ADMIN_EMAIL=
# Enter your secret Super Admin PIN (4-6 digits or passphrase, wrapped in quotes if containing #):
VITE_ADMIN_PIN="1234"
